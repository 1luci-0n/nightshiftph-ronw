// NightShiftPH Planner — Firestore security rules
//
// HOW TO USE THIS FILE:
// This isn't automatically read by your app — it only takes effect once you
// paste it into the Firebase Console yourself:
//   Firebase Console → Firestore Database → Rules tab → replace everything
//   with this file's contents → click "Publish".
//
// WHAT THIS DOES, IN PLAIN ENGLISH:
// - Anyone can READ the guild roster and staff list — this is what makes
//   public.html work without requiring members to log in.
// - Only someone who is (a) logged in AND (b) has a document in the `staff`
//   collection matching their email can WRITE roster changes.
// - Staff records: the Guild Leader can add/edit/remove anyone. A Co-Leader
//   or Developer can add/remove Admin Staff, but cannot create or edit a
//   Co-Leader or Developer record — only the Guild Leader can grant that
//   level of access, enforced by the database itself, not just the app's UI.
// - The Developer role has one extra, narrow permission: it can update the
//   `theme` field on ANY staff record (and only that field) — this is what
//   powers the "assign each staff member's theme" tool in Developer Tools.
//   It cannot use this to change anyone's role or other details.
// - `presence` (who's online) and `activity` (the recent-activity feed) are
//   admin-only and read-restricted to staff — not shown on the public page.
//   Activity entries can be created but never edited or deleted, since an
//   activity log that can be silently rewritten isn't worth much.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }

    function myRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role;
    }

    function isGuildLeader() {
      return isStaff() && myRole() == "Guild Leader";
    }

    function isDeveloper() {
      return isStaff() && myRole() == "Developer";
    }

    function canAssignAdminStaff() {
      return isStaff() && (myRole() == "Co-Leader" || myRole() == "Developer");
    }

    match /staff/{email} {
      allow read: if true;

      allow create: if isGuildLeader()
        || (canAssignAdminStaff() && request.resource.data.role == "Admin Staff");

      allow update: if isGuildLeader()
        || (canAssignAdminStaff() && request.resource.data.role == "Admin Staff")
        || (isDeveloper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["theme"]));

      allow delete: if isGuildLeader() || canAssignAdminStaff();
    }

    match /guildState/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /presence/{uid} {
      allow read: if isStaff();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /activity/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
